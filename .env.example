# ── MongoDB Atlas ────────────────────────────────────────────────
# Connection string from Atlas: Cluster → Connect → Drivers
# Remember to URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (optional; defaults to "accounter")
MONGODB_DB=accounter

# ── Clerk ────────────────────────────────────────────────────────
# Already written to .env.local by `clerk init` — copy values here for other environments.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Frontend API domain (encoded in your publishable key; needed by the /__clerk proxy)
CLERK_FAPI_URL=https://<your-fapi-domain>.clerk.accounts.dev
